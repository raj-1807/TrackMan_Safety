generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ──────────────────────────────────────────────────────────────────

enum Role {
  TRACKMAN
  SUPERVISOR
  CONTROL_ROOM
}

enum WorkerStatus {
  ON_DUTY
  OFF_DUTY
  SOS
  DISCONNECTED
}

enum ZoneType {
  MAINTENANCE
  DANGER
  SAFE
}

enum AlertType {
  ZONE_BREACH
  SOS
  TRAIN_APPROACHING
  DEVICE_OFFLINE
  GEOFENCE_EXIT
}

enum AlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AlertStatus {
  ACTIVE
  ACKNOWLEDGED
  RESOLVED
}

enum ShiftStatus {
  ACTIVE
  COMPLETED
  ABANDONED
}

// ─── Models ─────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role     @default(TRACKMAN)
  phone        String?
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  worker       Worker?
  zonesCreated Zone[]   @relation("ZoneCreator")
  alertsResolved Alert[] @relation("AlertResolver")

  @@map("users")
}

model Worker {
  id                 String       @id @default(uuid())
  userId             String       @unique @map("user_id")
  employeeId         String       @unique @map("employee_id")
  designation        String?
  department         String?
  status             WorkerStatus @default(OFF_DUTY)
  lastKnownLatitude  Float?       @map("last_known_latitude")
  lastKnownLongitude Float?       @map("last_known_longitude")
  lastLocationAt     DateTime?    @map("last_location_at")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  locations Location[]
  alerts    Alert[]
  shifts    Shift[]

  @@map("workers")
}

model Zone {
  id          String   @id @default(uuid())
  name        String
  description String?
  boundary    Json     // GeoJSON Polygon
  type        ZoneType @default(MAINTENANCE)
  isActive    Boolean  @default(true) @map("is_active")
  startTime   DateTime? @map("start_time")
  endTime     DateTime? @map("end_time")
  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  createdBy User    @relation("ZoneCreator", fields: [createdById], references: [id])
  alerts    Alert[]
  shifts    Shift[]

  @@map("zones")
}

model Location {
  id         String   @id @default(uuid())
  workerId   String   @map("worker_id")
  latitude   Float
  longitude  Float
  accuracy   Float?
  speed      Float?   @default(0)
  recordedAt DateTime @default(now()) @map("recorded_at")
  createdAt  DateTime @default(now()) @map("created_at")

  worker Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([workerId, recordedAt(sort: Desc)])
  @@index([recordedAt])
  @@map("locations")
}

model Alert {
  id          String        @id @default(uuid())
  workerId    String        @map("worker_id")
  zoneId      String?       @map("zone_id")
  type        AlertType
  severity    AlertSeverity @default(MEDIUM)
  status      AlertStatus   @default(ACTIVE)
  message     String
  latitude    Float?
  longitude   Float?
  createdAt   DateTime      @default(now()) @map("created_at")
  resolvedAt  DateTime?     @map("resolved_at")
  resolvedById String?      @map("resolved_by_id")

  worker     Worker    @relation(fields: [workerId], references: [id])
  zone       Zone?     @relation(fields: [zoneId], references: [id])
  resolvedBy User?     @relation("AlertResolver", fields: [resolvedById], references: [id])

  @@index([status, createdAt(sort: Desc)])
  @@index([workerId])
  @@map("alerts")
}

model Shift {
  id        String      @id @default(uuid())
  workerId  String      @map("worker_id")
  zoneId    String?     @map("zone_id")
  checkIn   DateTime    @default(now()) @map("check_in")
  checkOut  DateTime?   @map("check_out")
  status    ShiftStatus @default(ACTIVE)
  createdAt DateTime    @default(now()) @map("created_at")

  worker Worker @relation(fields: [workerId], references: [id])
  zone   Zone?  @relation(fields: [zoneId], references: [id])

  @@index([workerId, checkIn(sort: Desc)])
  @@map("shifts")
}
